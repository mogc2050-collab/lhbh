{
  "manifest_version": 2,
  "name": "Aflaak Core",
  "version": "0.1.0",
  "description": "Bridge between the page and the Aflaak browser app.",
  "browser_specific_settings": {
    "gecko": { "id": "aflaak-core@aflaak.com" }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
